# The image's own configuration: something to publish to, out of the box.
#
# It declares no streams.  A stream is created through the control API, which
# is the point of the runtime graph - the container starts empty and an
# operator or a controller builds the program it wants.

# The master runs as root (it binds the sockets and then setuids); the workers
# drop to www-data.  This is stated rather than left to nginx's compiled
# default of `nobody`, because the image chowns its writable directories to
# www-data and the two have to agree.
user www-data;

# Worker count comes from NGINX_WORKER_PROCESSES, which the entrypoint
# substitutes; it defaults to 1.  Read the entrypoint before raising it: the
# media graph is per-worker state and the control API is not worker-aware.
worker_processes ${NGINX_WORKER_PROCESSES};
error_log /var/log/nginx/error.log info;
pid /run/nginx.pid;

events {
    worker_connections 4096;
}

media_hls /var/lib/nginx/media/hls;

# Accept publishers.  A deployment that only pushes outward can drop this.
media_srt_listen 0.0.0.0:9000;
media_rtmp_listen 0.0.0.0:1935;

http {
    access_log off;

    server {
        listen 8080;

        location /media/api/ {
            media_api;
        }

        # The local HLS output, so a program can be watched immediately.
        location /hls/ {
            alias /var/lib/nginx/media/hls/;
        }
    }
}
