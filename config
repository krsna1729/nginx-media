ngx_addon_name=ngx_media

# SRT transport backend selection (goal doc 11.1).
#
# Haivision/srt is the reference SRT library the industry uses, and it is what
# this module links by default.  robotweax/srt is a clean-slate C++
# implementation of the *same* C API, so switching to it needs no code change
# at all: point the build at its headers and library, e.g.
#
#   PKG_CONFIG_PATH=/opt/robotweax/lib/pkgconfig make nginx
#   SRT_DIR=/opt/robotweax make nginx           # if it ships no .pc file
#
# robotweax/srt 0.2 installs its metadata as robotweax-srt.pc (and a static
# C++ archive), so on a host that also has libsrt the lookup of "srt" would
# quietly pick libsrt.  MEDIA_SRT_PKG names the pkg-config package instead:
#
#   SRT_DIR=/opt/robotweax MEDIA_SRT_PKG=robotweax-srt make nginx
#
# and the module, the qualification suite and the integration tests all run
# against it unchanged.  Which library ended up linked is reported at startup
# through srt_getversion().
#
# MEDIA_SRT_BACKEND selects which *implementations of the module's own
# transport contract* (ngx_media_srt_ops_t) are compiled in:
#
#   MEDIA_SRT_BACKEND=srt     the SRT library backend only (Haivision/srt or
#                             robotweax/srt, whichever the build points at).
#                             This is the default and the only production
#                             configuration.
#   MEDIA_SRT_BACKEND=udp     the UDP test double only, no libsrt.  Test
#                             builds: it speaks UDP, not SRT, and has none of
#                             SRT's reliability or encryption features.
#   MEDIA_SRT_BACKEND=both    both, runtime selectable with
#                             media_srt_backend srt|udp.  Used by the
#                             qualification suite to run one scenario against
#                             the library and against the test double.
#
# The UDP double is never a production transport.  It exists because the
# module's own contract (ngx_media_srt_ops_t) can be implemented more than
# once, and a boundary that is only ever crossed by one implementation is a
# boundary nobody has tested.  Robotweax does not need this mechanism at all:
# it exposes the same C API as Haivision/srt, so it is selected by the
# library the build links.
MEDIA_SRT_BACKEND=${MEDIA_SRT_BACKEND:-srt}
MEDIA_SRT_PKG=${MEDIA_SRT_PKG:-srt}
media_srt_pc_static=
case "$MEDIA_SRT_PKG" in
    # a static C++ archive: its private dependencies and the C++ runtime
    # have to be on the link line of a C program
    robotweax-srt) media_srt_pc_static=--static ;;
esac

# An SRT library that ships no .pc file (some robotweax builds) is selected
# with SRT_DIR instead.
if [ -n "$SRT_DIR" ] && { [ "$MEDIA_SRT_PKG" != srt ] \
        || [ -z "`pkg-config --libs srt 2>/dev/null`" ]; }; then
    export PKG_CONFIG_PATH="$SRT_DIR/lib/pkgconfig:$SRT_DIR/lib64/pkgconfig:$PKG_CONFIG_PATH"
fi

# The headers do not have to live in a system include directory: robotweax
# installs them under include/robotweax-srt, and its .pc file is what says so.
# CORE_INCS entries are prefixed with -I by nginx, so the flag is stripped.
media_srt_include_dirs=`pkg-config --cflags-only-I $MEDIA_SRT_PKG 2>/dev/null \
                        | sed 's/-I//g'`

case "$MEDIA_SRT_BACKEND" in
    srt)
        media_srt_srcs="$ngx_addon_dir/src/srt/ngx_media_srt_haivision.c"
        media_srt_libs=`pkg-config --libs $media_srt_pc_static $MEDIA_SRT_PKG 2>/dev/null`

        if [ -z "$media_srt_libs" ] && [ -n "$SRT_DIR" ]; then
            media_srt_libs="-L$SRT_DIR/lib -L$SRT_DIR/lib64 -lsrt"
            media_srt_include_dirs="$SRT_DIR/include $SRT_DIR/include/srt"
        fi

        if [ -z "$media_srt_libs" ]; then
            echo "nginx-media: libsrt not found (pkg-config --libs srt)" >&2
            echo "nginx-media: set SRT_DIR, or use MEDIA_SRT_BACKEND=udp for a libsrt-free build" >&2
            exit 1
        fi
        ;;
    both)
        media_srt_srcs="$ngx_addon_dir/src/srt/ngx_media_srt_haivision.c \
                        $ngx_addon_dir/src/srt/ngx_media_srt_udp.c"
        media_srt_libs=`pkg-config --libs $media_srt_pc_static $MEDIA_SRT_PKG 2>/dev/null`

        if [ -z "$media_srt_libs" ] && [ -n "$SRT_DIR" ]; then
            media_srt_libs="-L$SRT_DIR/lib -L$SRT_DIR/lib64 -lsrt"
            media_srt_include_dirs="$SRT_DIR/include $SRT_DIR/include/srt"
        fi

        if [ -z "$media_srt_libs" ]; then
            echo "nginx-media: libsrt not found (pkg-config --libs srt)" >&2
            exit 1
        fi
        ;;
    udp)
        media_srt_srcs="$ngx_addon_dir/src/srt/ngx_media_srt_udp.c"
        media_srt_libs=
        ;;
    *)
        echo "nginx-media: unknown MEDIA_SRT_BACKEND=$MEDIA_SRT_BACKEND" >&2
        echo "nginx-media: expected srt, udp or both" >&2
        exit 1
        ;;
esac

# The worker hook registers an external eventfd in the event loop, which is
# only possible after ngx_event_core_module has run ngx_event_process_init.
# Both modules declare type NGX_CORE_MODULE in their ngx_module_t; declaring
# them as EVENT here positions them after ngx_event_core_module in the module
# list, which is what orders their init_process hooks correctly.
ngx_module_type=EVENT
ngx_module_name="ngx_media_core_module ngx_media_srt_module ngx_media_rtmp_module"

# nginx's generated Makefile does not track an addon's own headers, so editing
# one rebuilds only the objects whose .c files changed - and an object built
# against an older struct layout disagrees with its neighbours about offsets.
# That produced a segfault in ngx_media_destination_find that survived every
# incremental build and vanished on a clean one.  Declaring the headers here
# makes any change to them rebuild the module.
ngx_module_deps=`ls $ngx_addon_dir/src/*/*.h 2>/dev/null | tr '\n' ' '`
ngx_module_srcs="$ngx_addon_dir/src/core/ngx_media_core_module.c \
                 $ngx_addon_dir/src/core/ngx_media_runtime.c \
                 $ngx_addon_dir/src/core/ngx_media_owner.c \
                 $ngx_addon_dir/src/core/ngx_media_ipc.c \
                 $ngx_addon_dir/src/core/ngx_media_route.c \
                 $ngx_addon_dir/src/core/ngx_media_graph.c \
                 $ngx_addon_dir/src/core/ngx_media_owner_dir.c \
                 $ngx_addon_dir/src/core/ngx_media_buffer.c \
                 $ngx_addon_dir/src/core/ngx_media_executor.c \
                 $ngx_addon_dir/src/core/ngx_media_transform.c \
                 $ngx_addon_dir/src/core/ngx_media_frame.c \
                 $ngx_addon_dir/src/core/ngx_media_feed.c \
                 $ngx_addon_dir/src/core/ngx_media_track.c \
                 $ngx_addon_dir/src/core/ngx_media_timeline.c \
                 $ngx_addon_dir/src/core/ngx_media_source.c \
                 $ngx_addon_dir/src/core/ngx_media_destination.c \
                 $ngx_addon_dir/src/core/ngx_media_egress_manager.c \
                 $ngx_addon_dir/src/core/ngx_media_file.c \
                 $ngx_addon_dir/src/core/ngx_media_hls_push.c \
                 $ngx_addon_dir/src/core/ngx_media_hls_playlist.c \
                 $ngx_addon_dir/src/core/ngx_media_http.c \
                 $ngx_addon_dir/src/core/ngx_media_hls_pull.c \
                 $ngx_addon_dir/src/core/ngx_media_hls_ingest.c \
                 $ngx_addon_dir/src/core/ngx_media_hls_profile.c \
                 $ngx_addon_dir/src/core/ngx_media_stream.c \
                 $ngx_addon_dir/src/core/ngx_media_registry.c \
                 $ngx_addon_dir/src/core/ngx_media_tombstone.c \
                 $ngx_addon_dir/src/core/ngx_media_policy.c \
                 $ngx_addon_dir/src/core/ngx_media_health.c \
                 $ngx_addon_dir/src/core/ngx_media_compat.c \
                 $ngx_addon_dir/src/core/ngx_media_selector.c \
                 $ngx_addon_dir/src/codec/ngx_media_nal.c \
                 $ngx_addon_dir/src/codec/ngx_media_aac.c \
                 $ngx_addon_dir/src/mpegts/ngx_media_ts_crc.c \
                 $ngx_addon_dir/src/mpegts/ngx_media_ts_demux.c \
                 $ngx_addon_dir/src/mpegts/ngx_media_ts_mux.c \
                 $ngx_addon_dir/src/hls/ngx_media_hls_segmenter.c \
                 $ngx_addon_dir/src/record/ngx_media_record.c \
                 $ngx_addon_dir/src/rtmp/ngx_media_rtmp_module.c \
                 $ngx_addon_dir/src/rtmp/ngx_media_rtmp_wire.c \
                 $ngx_addon_dir/src/rtmp/ngx_media_rtmp_adapter.c \
                 $ngx_addon_dir/src/rtmp/ngx_media_rtmp_destination.c \
                 $ngx_addon_dir/src/mpegts/ngx_media_ts_ingest.c \
                 $ngx_addon_dir/src/srt/ngx_media_srt_streamid.c \
                 $ngx_addon_dir/src/srt/ngx_media_srt_output_queue.c \
                 $ngx_addon_dir/src/srt/ngx_media_srt_output.c \
                 $ngx_addon_dir/src/srt/ngx_media_srt_transport.c \
                 $media_srt_srcs \
                 $ngx_addon_dir/src/srt/ngx_media_srt_ingest.c \
                 $ngx_addon_dir/src/srt/ngx_media_srt_module.c"
if [ "$MEDIA_SRT_PKG" = robotweax-srt ] && [ -n "$media_srt_libs" ]; then
    media_srt_libs="$media_srt_libs -lstdc++ -lm"
fi

ngx_module_libs="$media_srt_libs -lpthread"
ngx_module_order=

CORE_INCS="$CORE_INCS $media_srt_include_dirs \
                     $ngx_addon_dir/src/core $ngx_addon_dir/src/codec \
                     $ngx_addon_dir/src/mpegts $ngx_addon_dir/src/srt \
                     $ngx_addon_dir/src/hls $ngx_addon_dir/src/record \
                     $ngx_addon_dir/src/rtmp \
                     $ngx_addon_dir/src/api"

. auto/module

# control API: HTTP location handler
ngx_module_type=HTTP
ngx_module_name=ngx_media_api_module
ngx_module_deps=
ngx_module_srcs="$ngx_addon_dir/src/api/ngx_media_api_module.c"
ngx_module_libs=
ngx_module_incs="$ngx_addon_dir/src/core"
